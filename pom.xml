<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>studio.liuye</groupId>
    <artifactId>MobInteract</artifactId>
    <version>1.2.1</version>
    <packaging>jar</packaging>

    <name>MobInteract</name>
    <description>Humanoid mobs mine blocks and build bridges/stairs (Folia/Paper 1.21.8 ~ 26.x)</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven.compiler.release>25</maven.compiler.release>

        <!--
            编译目标 API。默认使用 Folia 1.21.8（最旧受支持版本），这样同一个 jar 既能在
            1.21.8 系服务端加载，也能在 26.2 / 26.3 上运行（新服务端接受旧的 api-version，
            反过来不行）。需要用 26.3 新 API 时才切到 -P folia-26.3。
        -->
        <api.group>dev.folia</api.group>
        <api.artifact>folia-api</api.artifact>
        <api.version>1.21.8-R0.1-SNAPSHOT</api.version>

        <!--
            写入 plugin.yml 的 api-version。必须 <= 服务端版本，否则服务端在开机扫描阶段
            直接拒绝加载：InvalidPluginException: Unsupported API version X
        -->
        <plugin.api-version>1.21.8</plugin.api-version>

        <junit.version>5.11.4</junit.version>
    </properties>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
    </repositories>

    <pluginRepositories>
        <pluginRepository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </pluginRepository>
    </pluginRepositories>

    <dependencies>
        <dependency>
            <groupId>${api.group}</groupId>
            <artifactId>${api.artifact}</artifactId>
            <version>${api.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <parameters>true</parameters>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <useModulePath>false</useModulePath>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Implementation-Title>MobInteract</Implementation-Title>
                            <Implementation-Version>${project.version}</Implementation-Version>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
            <!--
                fat jar：插件的运行期依赖全部打进来（当前没有第三方运行期依赖，
                shade 仍会产出可直接放入 plugins 目录的单一 jar，并剔除签名文件）。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <minimizeJar>false</minimizeJar>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            面向最新 Folia / Paper 26.3 的编译：可以使用 26.3 才有的 API，代价是
            api-version 被抬到 26.3，只能装到 26.3+ 的服务端。
            用法：mvn -P folia-26.3 clean package
        -->
        <profile>
            <id>folia-26.3</id>
            <properties>
                <api.group>dev.folia</api.group>
                <api.artifact>folia-api</api.artifact>
                <api.version>26.3.build.5-alpha</api.version>
                <plugin.api-version>26.3</plugin.api-version>
            </properties>
        </profile>

        <!--
            纯 Paper 回退编译（旧脚本仍在用 -P paper-1.21）：编译目标与默认一致，
            只是把 API 换成 Paper 而不是 Folia，便于在不支持 Folia 调度的环境里排错。
            用法：mvn -P paper-1.21 clean package
        -->
        <profile>
            <id>paper-1.21</id>
            <properties>
                <api.group>io.papermc.paper</api.group>
                <api.artifact>paper-api</api.artifact>
                <api.version>1.21.8-R0.1-SNAPSHOT</api.version>
                <plugin.api-version>1.21.8</plugin.api-version>
            </properties>
        </profile>
    </profiles>
</project>
